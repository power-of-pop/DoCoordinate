<!DOCTYPE html>
<html>
  <head>
    <title>DoCoordinate</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <script src="https://kit.fontawesome.com/ed931dfcea.js" crossorigin="anonymous"></script>
    <%= stylesheet_pack_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body class="d-flex flex-column" style="min-height: 100vh;">
    <header class="shadow-sm bg-image" style="position: relative; background-image: url('<%= asset_path('pexels-ron-lach-8274720.jpg') %>'); background-size: cover; background-position: 10% 15%;">
      <nav class="navbar navbar-expand-lg navbar-light">
        <div class="container">
          <a class="navbar-brand p-3" href="/"><span><%= image_tag 'S__46997507.jpg', size: "60x60" %></span></a>
          <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse justify-content-end" id="navbarNavDropdown">
            <ul class="navbar-nav d-flex flex-row ml-auto">
              <% if admin_signed_in?  %>
                <li class="nav-item mr-5">
                  <%= link_to 'User List', admin_users_path, class: 'btn btn-dark' %>
                </li>
                <li class="nav-item mr-5">
                  <%= link_to 'Post List', admin_posts_path, class: 'btn btn-dark' %>
                </li>
                <li class="nav-item mr-5">
                  <%= link_to 'Community', admin_groups_path, class: 'btn btn-dark' %>
                </li>
                <li class="nav-item">
                  <%= link_to 'Log Out', destroy_admin_session_path, class: 'btn btn-dark', method: :delete %>
                </li>
        
              <% elsif user_signed_in? %>
                <li class="nav-item mr-5">
                  <%= link_to 'My Page', user_path(current_user.id), class: 'btn btn-dark' %>
                </li>
                <li class="nav-item mr-5">
                  <%= link_to 'New Post', new_post_path, class: 'btn btn-dark' %>
                </li>
                <li class="nav-item mr-5">
                  <%= link_to 'Post List', posts_path, class: 'btn btn-dark' %>
                </li>
                <li class="nav-item mr-5">
                  <%= link_to 'Community', groups_path, class: 'btn btn-dark' %>
                </li>
                <li class="nav-item">
                  <%= link_to 'Log Out', destroy_user_session_path, class: 'btn btn-dark', method: :delete %>
                </li>

              <% else %>
                <li class="nav-item mr-5">
                  <%= link_to 'About', about_path, class: 'btn btn-dark' %>
                </li>
                <li class="nav-item mr-5">
                  <%= link_to 'Sign Up', new_user_registration_path, class: 'btn btn-dark' %>
                </li>
                <li class="nav-item">
                  <%= link_to 'Log In', new_user_session_path, class: 'btn btn-dark' %>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      </nav>
    </header>
    <main class="flex-grow-1" style="height: auto;">
      <%= render "layouts/flash_messages" %>
      <div class="d-flex justify-content-center" >
        <%= render 'searches/form' %>
      </div>
      <%= yield %>
    </main>
    <footer class="bg-dark text-white pt-2 pb-2 mt-auto">
      <div class="container mt-3">
        <div class="row">
          <div class="mx-auto">
            <h5>Let's enjoy fashion!</h5>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
