<% if obj.errors.any? %>
  <div class="container">
    <!--<h3><%#= pluralize(obj.errors.count, "error") %> prohibited this obj from being saved:</h3>-->
    <ul class="alert alert-warning" style="list-style:none;">
      <% obj.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
