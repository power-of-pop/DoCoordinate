<div class='container px-5 px-sm-0'>
  <div class='row'>
    <div class='col-md-10'>
      <h2>Group Detail</h2>
      <table class='table table-inverse'>
        <thead>
          <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Introduction</th>
            <th>Members</th>
            <th colspan="3"></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>
              <%= image_tag url_for(@group.group_image), size: "150x150" %>
            </td>
            </td>
            <td><%= @group.name %></td>
            <td><%= @group.introduction %></td>
            <td>
              <% @group.users.each do |user| %>
                <li style="list-style: none;"><%= user.name %></li>
              <% end %>
            </td>
            <td>
              <%= link_to 'グループ削除', admin_group_path(@group), method: :delete,  class: "btn btn-outline-danger text-danger bg-transparent", data: { confirm: "本当に削除しますか？" } %>
              <%= link_to "チャット",admin_group_chat_path(@group), class: "btn btn-outline-dark text-dark" %>
            </td>
          </tr>
        </tbody>
      </table>
    </div>