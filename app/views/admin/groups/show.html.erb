<div class='container px-5 px-sm-0'>
  <div class="row d-flex justify-content-center">
    <div class="col-10">
      <div class="card mb-4">
        <div class="row no-gutters">
          <!-- グループ画像 -->
          <div class="col-md-3">
            <img src="<%= url_for(@group.group_image) %>" class="card-img" alt="<%= @group.name %>" style="object-fit: contain; width: 100%; height: 100%; max-height: 200px;">
          </div>
          <div class="col-md-9">
            <div class="card-body">
              <h3 class="card-title"><%= @group.name %></h3>
              <p class="card-text"><%= @group.introduction %></p>
            </div>
          </div>
        </div>
      </div>

      <!-- メンバーリスト -->
      <div class="mb-4">
        <h4>Member</h4>
        <div class="d-flex flex-wrap">
          <% @group.users.each do |user| %>
            <div class="d-flex align-items-center mr-3 mb-2">
              <span><%= image_tag url_for(user.profile_image), size: "40x40" %></span>
              <span class="ml-2"><%= user.name %></span>
            </div>
          <% end %>
        </div>
      </div>


      <div class="d-flex">
        <div>
          <%= link_to "Group Chat!", admin_group_chat_path(@group), class: "btn btn-info text-white mr-3" %>
        </div>
        <div>
          <%= link_to 'グループ削除', admin_group_path(@group), method: :delete, class: "btn btn-outline-danger text-danger bg-transparent", data: { confirm: "本当に削除しますか？" } %>
        </div>
      </div>
    </div>
  </div>
</div>
