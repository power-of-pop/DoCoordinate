<div class='container px-5 px-sm-0'>
<h2>User Page</h2>
  <div class='row'>
    <div class="col-md-4">
      <%= image_tag @user.get_profile_image(150,150) %>
    </div>
    <div class="col-md-8">
      <table class='table'>
        <tbody>
          <tr>
            <th width="10%" class="border-bottom">name</th>
            <td width="90%" class="border-bottom text-wrap text-break"><%= @user.name %></td>
          </tr>
          <tr>
            <th class="border-bottom">profile</th>
            <td class="border-bottom text-wrap text-break"><%= @user.profile %></td>
          </tr>
        </tbody>
      </table>
      <div class="mt-3">
        <%= link_to "Delete Account", admin_user_path(@user), class: "btn btn-danger destroy-user", method: :delete, data: { confirm: "本当に退会しますか？" } %>
      </div>
    </div>
  </div>

  <div class="row mt-4">
    <h2 class="col-12 mb-4">Posts</h2>
    <div class="row">
        <% @posts.each_slice(5) do |posts_row| %>
          <div class="row">
            <% posts_row.each do |post| %>
              <div class="col">
                <p>
                  <%= link_to admin_post_path(post.id) do %>
                    <%= image_tag url_for(post.post_image), size: "200x300" %>
                  <% end %>
                </p>
                <p><%= link_to truncate(post.title, length: 15, omission: '...'), admin_post_path(post) %></p>
                <!-- 15文字を超えた場合は「...」を付ける -->
                <p><%= link_to "#{post.post_comments.count} コメント", admin_post_path(post.id) %></p>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
  </div>
</div>
  </div>
</div>