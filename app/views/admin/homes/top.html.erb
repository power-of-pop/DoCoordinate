<h1>管理者Top Page</h1>

<div class="stats">
  <p>ユーザー数: <%= @user_count %></p>
  <p>投稿数: <%= @post_count %></p>
  <p>アクティブユーザー: <%= @active_user_count %></p>
</div>

<h2>最近のアクティビティ</h2>
<ul>
  <% @recent_users.each do |user| %>
    <% if user.email != "guest@example.com" %>
      <li><%= user.name %> - <%= user.created_at.strftime('%Y/%m/%d %H:%M:%S') %></li>
    <% end %>
  <% end %>
</ul>

<h2>モデレーションが必要な投稿</h2>
<%
=begin%>
 <ul>
  <% @flagged_posts.each do |post| %>
    <li><%= post.title %> - <%= post.reported_at %></li>
  <% end %>
</ul> 
<%
=end%>

<div class="links">
  <%= link_to 'ユーザー一覧', admin_users_path %>
  <%= link_to '投稿一覧', admin_posts_path %>
</div>
