<% if user_signed_in? or admin_signed_in? %>
<div class="search_form">
  <%= form_with url: search_path, local: true, method: :get do |f| %>
      <%= f.text_field :word %>
      <%= f.select :range, options_for_select([['Post'], ['User'], ['Community']]) %>
      <%= f.submit "Search", class: "btn-sm btn-primary" %>
    <% end %>
  </div>
<% end %>

