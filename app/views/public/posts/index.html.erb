<div class="container px-5 px-sm-0">
  <div class="row">
    <div class="col">
      <div class="row">
        <span class = "title", style="font-size: 2.5rem; display:flex;">
          <h1 class="bg-light">Post Lists</h1>
        </span>
      </div>
      <br>
      
      <div class="row">
        <% @posts.each_slice(4) do |posts_row| %>
          <div class="row">
            <% posts_row.each do |post| %>
              <div class="col">
                <div class="card" style="height: 350px;">
                  <%= link_to post_path(post.id) do %>
                    <%= image_tag url_for(post.post_image), class: "card-img-top", style: "height: 200px; width: 100%; object-fit: cover;" %>
                  <% end %>
                  <div class="card-body">
                    <h5 class="card-title">
                    <%= link_to truncate(post.title, length: 15, omission: '...'), post_path(post) %> 
                      <!-- 15文字を超えた場合は「...」を付ける -->
                    </h5>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
      
    </div>
  </div>
</div>
