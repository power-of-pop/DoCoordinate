<div class="container px-5 px-sm-0">
  <div class="row">
    <div class="col-md-3 space-above">
      ジャンル一覧
    </div>

    <div class="col-md-8">
      <div class="row">
        <span class = "title", style="font-size: 2.5rem; display:flex;">
          <h1 class="bg-light">Post Lists</h1>
        </span>
      </div>
      <br>
      
      <div class="row">
        <% @posts.each_slice(4) do |posts_row| %>
          <div class="row">
            <% posts_row.each do |post| %>
              <div class="col">
                <p>
                  <%= link_to post_path(post.id) do %>
                    <%= image_tag url_for(post.post_image), size: "150x200" %>
                  <% end %>
                </p>
                <p><%= link_to post.title, post_path(post) %></p>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
