<div class = "container">

  <div class = "row">
    <div class = "col-sm-12 col-md-6 col-lg-5 px-5 px-sm-0 mx-auto">
      <span class = "title" style="font-size: 2rem;"> New Post </span><br>

      <%= form_with(model: @post, url: posts_path) do |form| %>
      <%= render 'layouts/errors', obj: @post %>

        <div class="form-group">
          <label for="image" class="col-sm-3 col-form-label">写真</label>
          <%= form.file_field :post_image, accept: "image/*", class: "form-control-file" %>
        </div>

        <div class = "form-group">
          <label for="title", class="col-sm-3 col-form-label">タイトル</label>
          <%= form.text_field :title,placeholder:"タイトル", class:"form-control" %>
        </div>

        <div class = "form-group">
          <label for="body", class="col-sm-3 col-form-label">説明文</label><br>
          <%= form.text_area :body, placeholder:"ここに説明文を記述します", class:"form-control" %><br>
        </div>
        <br>
        <div class = "submit row justify-content-center">
          <%= form.submit "Post!", class: "btn btn-info" %>
        </div>
      <% end %>
      <br>
    </div>
  </div>
</div>
