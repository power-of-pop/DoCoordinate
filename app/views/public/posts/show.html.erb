<%= render 'layouts/errors', obj: @post_comment %>
<div class="container px-5 px-sm-0">
<h2>Post details</h2>
  <div class="row">
    <div class="col-md-5 col-12 mb-5 text-center">
        <%= image_tag url_for(@post.post_image), class: "img-fluid w-75" %>
    </div>
    <div class="col-md-7 col-12">
      <table class='table'>
        <tbody>
          <tr>
            <% if @post.user %>
              <th class="border-bottom"><%= link_to @post.user.name, user_path(@post.user) %></th>
            <% end %>
          </tr>
          <tr>
            <th class="border-bottom text-wrap text-break"><%= @post.title %></th>
          </tr>
          <tr>
            <th class="border-bottom text-wrap text-break"><%= simple_format(@post.body, sanitize: true) %></th>
          </tr>
          <tr>
            <td class="border-bottom text-wrap text-break"><%= @post.created_at.strftime('%Y/%m/%d %H:%M:%S') %></td>
          </tr>
          <% if @post.user == current_user %>
          <tr>
            <th>
              <%= link_to "Edit post", edit_post_path(@post), class: "btn btn-success", style: "margin-right: 30px;" %>
              <%= link_to "Delete", post_path(@post), method: :delete, data: { confirm: "本当に消去しますか？" }, class: "btn btn-danger" %>
            </th>
          </tr>
          <% end %>
        </tbody>
      </table>

      <!-- タグ表示 -->
      <div class="mb-3">
        <% @post.tags.each do |tag| %>
          <span class="badge bg-info text-white me-3"><%= tag.name %></span>
        <% end %>
      </div>
      
      <!-- いいね -->
      <div>
        <% if @post.favorited_by?(current_user) %>
          <p>
            <%= link_to post_favorite_path(@post), method: :delete do %>
              🩷<%= @post.favorites.count %> いいね
            <% end %>
          <p>
        <% else %>
          <p>
            <%= link_to post_favorite_path(@post), method: :post do %>
              ♡<%= @post.favorites.count %> いいね
            <% end %>
          <p>
        <% end %>
      </div>

      <!-- 投稿コメント -->
      <div>
        <p>コメント件数：<%= @post.post_comments.count %></p>
        <% @post.post_comments.each do |post_comment| %>
          <div class="row mb-2 border-bottom">
            <div class="col-2">
              <%= image_tag post_comment.user.get_profile_image(50,50) %><br>
              <%= link_to post_comment.user.name, user_path(@user) %>
            </div>
            <div class="col-6">
              <%= simple_format(post_comment.comment) %>
              <%= post_comment.created_at.strftime('%Y/%m/%d %H:%M:%S') %>
            </div>
            <div>
              <% if post_comment.user == current_user %>
                <%= link_to "Delete", post_post_comment_path(post_comment.post, post_comment), method: :delete, data: { confirm: "本当に消去しますか？" }, class: "btn btn-danger" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
      <div>
        <%= form_with model: [@post, @post_comment] do |f| %>
          <div class="form-group">
            <%= f.text_area :comment, rows: '2', placeholder: "コメントを入力", class: "form-control" %>
          </div>
          <div class="form-group">
            <%= f.submit "Send", class: "btn btn-info" %>
          </div>
        <% end %>
      </div>

      <div class="mb-3">
        <%= link_to 'Back', posts_path, class: "back" %>
      </div>
    </div>
  </div>
</div>