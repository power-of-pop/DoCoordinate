<div class='container px-5 px-sm-0'>
<h2>User Page</h2>
  <div class='row'>
    <div class="col-md-4">
      <%= image_tag @user.get_profile_image(150,150) %>
    </div>
    <div class="col-md-8">
      <table class='table'>
        <tbody>
          <tr>
            <th width="10%" class="border-bottom">name</th>
            <td width="90%" class="border-bottom text-wrap text-break"><%= @user.name %></td>
          </tr>
          <tr>
            <th class="border-bottom">profile</th>
            <td class="border-bottom text-wrap text-break"><%= @user.profile %></td>
          </tr>
        </tbody>
      </table>
      <% if current_user == @user && @user.email != "guest@example.com" %>
        <div>
          <%= link_to 'Edit info',edit_user_path(@user), class: 'btn btn-success mr-4 mt-2' %>
          <%= link_to 'New post',new_post_path, class: 'btn btn-info mr-4 mt-2' %>
          <%= link_to 'Favorite Posts', favorites_user_path, class: 'btn btn-dark mt-2' %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="row mt-4">
    <h2 class="col-12 mb-4 px-5 px-sm-0">Posts</h2>
    <div class="row ml-4">
        <%= render "public/posts/posts", posts: @posts %>
    </div>
  </div>

  </div>
  </div>
</div>
