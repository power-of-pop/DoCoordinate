<div class='container'>
  <div class='row'>
    <div class="col-sm-12 col-md-8 col-lg-5 px-5 px-sm-0 mx-auto">
    <h2>User info</h2>
    <%= form_with model:@user, local:true do |f| %>
      <%= render 'layouts/errors', obj: @user %>
      <div class="form-group">
        <%= f.label :image, "プロフィール写真"%>
        <%= f.file_field :profile_image, class: "form-control-file user_image", accept: 'image/*' %>
      </div>
      <div class="form-group">
        <%= f.label :name %>
        <%= f.text_field :name, class: "form-control name" %>
      </div>
      <div class="form-group">
        <%= f.label :profile, "自己紹介" %>
        <%= f.text_area :profile, class: "form-control profile" %>
      </div>
      <div class="form-group">
        <button type="submit" class="btn btn-success">Update</button>
      </div>
      <div class="mt-3">
        <%= link_to "Delete Account",user_path(current_user.id), class: "btn btn-danger destroy-user", method: :delete, "data-confirm" => "本当に退会しますか？" %>
      </div>
    <% end %>
  </div>
</div>
