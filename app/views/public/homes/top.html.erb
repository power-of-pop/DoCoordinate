
<div class="container">
  <div class="row">
    <h1 class='mt-5 mx-auto text-center' style="font-size: 3em; font-family: 'Arial', sans-serif;">welcome to <strong>Do Coordinate</strong> !</h1>
    <div class='mt-3 mx-auto text-center col-11 col-sm-10 col-lg-8 col-xl-6'>
      <h3 class="mb-5">Let's talk about coordination together.</h3>
      <div class="btn-wrapper col-10 mx-auto">
        <div class="row mb-3">
          <%= link_to "Guest log in", public_guest_sign_in_path, class: "btn btn-warning btn-sm btn-block mb-3 sign_in", method: :post %>
        </div>
        <div class="row mb-3">
          <%= link_to 'Log in',new_user_session_path, class: "btn btn-info btn-sm btn-block mb-3 sign_in" %>
        </div>
        <div class="row mb-3">
          <%= link_to 'Sign up',new_user_registration_path, class: "btn btn-success btn-sm btn-block sign_up" %>
        </div>
      </div>
    </div>
  </div>
</div>
