
<%= render 'layouts/errors', obj: @group_chat %>
  <div class="container">
    <h2>Group chat in "<%= @group.name %>"</h2>
    <!-- グループチャットのメッセージを表示 -->
    <div class="chat-box mb-4" style="max-height: 400px; overflow-y: auto;">
      <% @group.group_chats.each do |group_chat| %>
        <div class="message-row d-flex mb-3 <%= 'my-message' if group_chat.user == current_user %>">
          <!-- ユーザー画像 -->
          <div class="user-image me-3">
            <%= image_tag group_chat.user.get_profile_image(50, 50), class: "rounded-circle" %>
          </div>

          <!-- メッセージ内容 -->
          <div class="message-content flex-grow-1">
            <div class="d-flex justify-content-between">
              <div class="user-name fw-bold">
                <%= group_chat.user.name %>
              </div>
              <div class="message-time text-muted small">
                <%= group_chat.created_at.strftime('%Y/%m/%d %H:%M') %>
              </div>
            </div>
            <% if group_chat.comment.present? %>
              <div class="message-text bg-light p-2 rounded mt-1">
                <%= group_chat.comment %>
              </div>
            <% end %>

            <!-- 画像があれば表示 -->
            <% if group_chat.chat_image.attached? %>
              <div class="message-image mt-2">
                <%= image_tag group_chat.chat_image.variant(resize_to_limit: [200, 200]).processed, class: 'img-fluid' %>
              </div>
            <% end %>

            <!-- 削除ボタン（自分のメッセージのみ） -->
            <% if group_chat.user == current_user && group_chat.id.present? %>
              <%= link_to "Delete", group_group_chat_path(@group, group_chat), method: :delete, data: { confirm: "本当に削除しますか?" }, class: "btn btn-danger btn-sm mt-2" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

      <!--メッセージ入力フォーム-->
    <%= form_with(model: [@group, @group_chat], class: "input-area d-flex") do |f| %>
      <div class="row">
        <div class="col-12 col-md-8 offset-md-2">
          <div class="input-group">
            <%= f.text_area :comment, rows: 3, class: "form-control", placeholder: "コメント..." %>
          </div>
          <div class="input-group mt-2">
            <%= f.file_field :chat_image, class: "form-control" %>
            <button type="submit" class="btn btn-primary ms-2">
              send
            </button>
          </div>
        </div>
      </div>
    <% end %>
  </div>


