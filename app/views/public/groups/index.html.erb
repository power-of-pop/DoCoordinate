<div class='container px-5 px-sm-0'>
  <div class='row'>
    <div class='col-md-10 offset-md-1 d-flex justify-content-between align-items-center'>
      <h2> Communities</h2>
      <%= link_to "Create Community", new_group_path, class: "btn btn-primary mb-3 d-none d-sm-block" %>
      <p class = "button d-block d-sm-none">
        <%= link_to new_group_path do %>
          <i class="fa-solid fa-circle-plus fa-xl"></i>
        <% end %>
      </p>
    </div>
  </div>

  <div class="row">
    <div class='col-md-10 offset-md-1'>
      <table class='table table-hover'>
        <thead>
          <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Members</th>
          </tr>
        </thead>
        <tbody>
          <% @groups.each do |group| %>
            <tr>
              <td>
                <%= image_tag group.get_group_image(100,100) %>
              </td>
              <td><%= link_to group.name,group_path(group), class: "h5" %></td>
              <td><%= group.group_users.count %></td>
            </tr>
          <% end %>
        </tbody>
      </table> 
    </div>
  </div>
</div>