<div class='container px-5 px-sm-0'>
  <div class='row'>
  <%=link_to "Create Community",new_group_path %>

    <div class='col-md-8 offset-md-1'>
      <h2>Groups</h2>
      <table class='table'>
        <thead>
          <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Members</th>
            <th colspan="3"></th>
          </tr>
        </thead>
        <tbody>
          <% @groups.each do |group| %>
            <tr>
              <td>
                <%= image_tag group.get_group_image(100,100) %>
              </td>
              <td><%= link_to group.name,group_path(group) %></td>
              <td><%= group.group_users.count %></td>
            </tr>
          <% end %>
        </tbody>
      </table> 
    </div>
  </div>
</div>